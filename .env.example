# Supabase — use these names in Cursor / Vercel secret stores.
# Avoid NEXT_PUBLIC_ in Cursor secret names; the app maps them for the browser client.
#
# From Supabase Dashboard → Project Settings → API:
#   Project URL  → SUPABASE_URL
#   anon public  → SUPABASE_ANON_KEY
#   service_role → SUPABASE_SERVICE_ROLE_KEY  (server only; never expose to browser)

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for the browser Supabase client (login/signup/sign-out).
# Same values as SUPABASE_URL / SUPABASE_ANON_KEY — Next only exposes NEXT_PUBLIC_* to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URL (email confirm / auth redirects / Vercel)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
